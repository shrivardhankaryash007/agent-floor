<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.agent-floor.weekly-probe</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>9</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>ProgramArguments</key>
	<array>
		<string>__REPO_DIR__/.venv/bin/agent-floor</string>
		<string>probe</string>
		<string>--out</string>
		<string>__HOME__/.local/state/agent-floor/probes/latest</string>
	</array>
	<!-- srt is a `#!/usr/bin/env node` script and launchd's default PATH has no node:
	     without this the probe writes nothing and exits 1. Point it at your node.
     Template: replace __HOME__, __REPO_DIR__ and __NODE_BIN_DIR__ before `launchctl bootstrap`. -->
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__NODE_BIN_DIR__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__HOME__/.local/state/agent-floor/weekly-probe.stdout.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/.local/state/agent-floor/weekly-probe.stderr.log</string>
</dict>
</plist>
